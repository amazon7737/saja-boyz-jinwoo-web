{
  "name": "saja-boyz-jinwoo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10.34.6 <11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:harness": "sh tests/hooks.sh && sh tests/loop.sh && sh tests/sobaya.sh",
    "format": "prettier --write src docs/project.md docs/architecture.md docs/figma-analysis.md *.json *.mjs *.ts",
    "format:check": "prettier --check src docs/project.md docs/architecture.md docs/figma-analysis.md *.json *.mjs *.ts",
    "check": "pnpm run lint && pnpm run typecheck && pnpm test && pnpm run build"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "jsdom": "27.4.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vitest": "5.0.3"
  },
  "type": "module",
  "packageManager": "pnpm@10.34.6"
}
